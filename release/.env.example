# Copy to release/.env.local (ignored by Git). Leave these empty until signing.
# Shell environment / CI secrets take precedence over nonempty local values.
# macOS certificate: base64 PKCS#12; identity may instead refer to your keychain.
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
APPLE_SIGNING_IDENTITY=
# Notarization: use ONE complete authentication method.
# Method A: App Store Connect API; key path must be absolute.
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=
# Method B: Apple ID and app-specific password.
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
