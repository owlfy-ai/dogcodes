{
  "name": "dogcodes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "icons": "node scripts/generate-app-icons.mjs",
    "dev": "pnpm --filter @dogcodes/desktop dev",
    "desktop:dev": "pnpm --filter @dogcodes/desktop desktop:dev",
    "desktop:package": "node scripts/package-desktop.mjs",
    "test:release": "node --test scripts/package-desktop.test.mjs scripts/prepare-source-snapshot.test.mjs",
    "source:snapshot": "node scripts/prepare-source-snapshot.mjs",
    "check:release-inputs": "node scripts/check-release-inputs.mjs",
    "build": "pnpm --filter @dogcodes/desktop build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
