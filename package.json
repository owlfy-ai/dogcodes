{
  "name": "dogcodes",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "icons": "node scripts/generate-app-icons.mjs",
    "dev": "pnpm --filter @dogcodes/desktop dev",
    "desktop:dev": "pnpm --filter @dogcodes/desktop desktop:dev",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:release": "node scripts/desktop-release.mjs",
    "test:release": "node --test scripts/package-desktop.test.mjs scripts/desktop-release.test.mjs scripts/website-downloads.test.mjs scripts/prepare-computer-use.test.mjs",
    "test:desktop-dev": "node --test scripts/desktop-dev.test.mjs",
    "test:local": "node scripts/test-local.mjs",
    "check:release-inputs": "node scripts/check-release-inputs.mjs",
    "build": "pnpm --filter @dogcodes/desktop build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
